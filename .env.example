# Copy this file to .env and fill in real values. .env is gitignored.

# --- Database (Postgres) ---
# Render → your PostgreSQL instance → "Connections".
# Locally, use the EXTERNAL connection string (host ends in .render.com — needs SSL).
# On Render, use the INTERNAL string (host like dpg-xxxx-a — faster, in-network).
DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Google OAuth (sign-in) ---
# console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web application).
# Authorized redirect URI must be <BASE_URL>/auth/google/callback.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Public base URL used to build the OAuth callback.
# Local: http://localhost:3000   |   Render: https://<your-app>.onrender.com
BASE_URL=http://localhost:3000

# Optional allowlist (defense-in-depth on top of Google "Test users").
# Comma-separated emails permitted to sign in. Empty = rely on Google test users.
ALLOWED_EMAILS=

# Session signing secret for sign-in cookies. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- Email (colleague dependency notifications; unchanged) ---
# Using SendGrid: set SENDGRID_API_KEY. Or use SMTP_* for a generic SMTP server.
SENDGRID_API_KEY=
FROM_EMAIL=you@company.com
FROM_NAME=Your Name
# SMTP alternative:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@company.com
# SMTP_PASS=your-app-password
