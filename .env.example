# SMTP config for colleague dependency emails.
# Copy this file to .env and fill in real values. .env is gitignored.
#
# Gmail: use an App Password (Google Account -> Security -> App passwords),
# not your normal login password, if 2FA is on.
# For Outlook/Microsoft 365 or SendGrid, swap host/port/user/pass accordingly.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@company.com
SMTP_PASS=your-app-password
FROM_NAME=Your Name

# Session signing secret for sign-in cookies. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: override the SQLite file location (defaults to data/tracker.db)
# DB_FILE=./data/tracker.db
